  "grammar": [
    {
      "pattern": "N이/가 있어요 / 없어요",
      "meaning": "Có N / Không có N",
      "explanation_vi": "있다 = có/tồn tại, 없다 = không có. Đây là cặp từ cơ bản nhất trong tiếng Hàn. Trong tiếng Việt ta nói 'có/không có', tiếng Hàn đặt danh từ trước: 샴푸가 있어요 = dầu gội đầu + có.",
      "examples": [
        { "kr": "칫솔이 있어요.", "vi": "Có bàn chải đánh răng." },
        { "kr": "수건이 없어요.", "vi": "Không có khăn tắm." },
        { "kr": "돈이 있어요?", "vi": "Bạn có tiền không?" }
      ]
    },
    {
      "pattern": "어디에서 살 수 있어요?",
      "meaning": "Có thể mua ở đâu?",
      "explanation_vi": "-(으)ㄹ 수 있어요 = có thể làm gì. 어디에서 = ở đâu, 살 = mua (동사 사다). Cấu trúc này hay xuất hiện trong đề thi EPS để hỏi địa điểm làm việc, mua sắm.",
      "examples": [
        { "kr": "어디에서 살 수 있어요?", "vi": "Có thể mua ở đâu?" },
        { "kr": "어디에서 일할 수 있어요?", "vi": "Có thể làm việc ở đâu?" }
      ]
    },
    {
      "pattern": "N에서 N까지",
      "meaning": "Từ N đến N (giá/địa điểm/thời gian)",
      "explanation_vi": "에서 = từ, 까지 = đến. Dùng cho phạm vi giá tiền, thời gian, địa điểm. Giống 'từ... đến' trong tiếng Việt.",
      "examples": [
        { "kr": "3,000원에서 5,000원이에요.", "vi": "Từ 3.000 đến 5.000 won." },
        { "kr": "아침 8시에서 저녁 6시까지 일해요.", "vi": "Làm việc từ 8 giờ sáng đến 6 giờ tối." }
      ]
    }
