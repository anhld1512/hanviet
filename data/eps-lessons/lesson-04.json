  "exercises": [
    {
      "id": 1,
      "type": "multiple_choice",
      "question": "Tổ trưởng hỏi '지금 뭐 해요?', bạn đang lắp ráp linh kiện, trả lời:",
      "options": [
        "부품을 조립했어요",
        "부품을 조립하고 있어요",
        "부품을 조립할 거예요",
        "부품을 조립해요"
      ],
      "correct": 1,
      "explanation": "-고 있어요 = đang làm. Đang lắp ráp linh kiện = 부품을 조립하고 있어요. 조립했어요 = đã lắp, 조립할 거예요 = sẽ lắp."
    },
    {
      "id": 2,
      "type": "multiple_choice",
      "question": "Tổ trưởng nói '확인하세요', nghĩa là:",
      "options": ["Bạn đã kiểm tra rồi", "Hãy kiểm tra", "Đang kiểm tra", "Không cần kiểm tra"],
      "correct": 1,
      "explanation": "-세요 là dạng mệnh lệnh lịch sự. 확인하세요 = Hãy kiểm tra. Dạng này thường được tổ trưởng dùng khi hướng dẫn công việc."
    },
    {
      "id": 3,
      "type": "multiple_choice",
      "question": "'조립하다'có nghĩa là:",
      "options": ["Vận hành", "Lắp ráp", "Vận chuyển", "Kiểm tra"],
      "correct": 1,
      "explanation": "조립하다 = lắp ráp. 작동하다 = vận hành, 운반하다 = vận chuyển, 확인하다 = kiểm tra."
    },
    {
      "id": 4,
      "type": "multiple_choice",
      "question": "Hộp quá nặng, bạn không thể nhấc một mình, nói:",
      "options": [
        "상자가 무거워요. 혼자 할 수 있어요.",
