  "grammar": [
    {
      "pattern": "-고 있어요",
      "meaning": "Đang làm gì đó (thì hiện tại tiếp diễn)",
      "explanation_vi": "Giống 'đang' trong tiếng Việt. Cách tạo: bỏ 다 của động từ + 고 있어요. Ví dụ: 일하다 → 일하고 있어요 = đang làm việc. 먹다 → 먹고 있어요 = đang ăn.",
