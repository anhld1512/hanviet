        { "kr": "지금 일하고 있어요.", "vi": "Bây giờ đang làm việc." }
      ]
    },
    {
      "pattern": "-(으)세요",
      "meaning": "Hãy... (mệnh lệnh lịch sự)",
      "explanation_vi": "Dạng mệnh lệnh lịch sự, dùng khi cấp trên chỉ thị hoặc hướng dẫn. Sau nguyên âm hoặc ㄹ dùng -세요, sau phụ âm dùng -으세요.",
      "examples": [
        { "kr": "이 버튼을 누르세요.", "vi": "Hãy nhấn nút này." },
