  "grammar": [
    {
      "pattern": "N월 N일이에요",
      "meaning": "Ngày N tháng N",
      "explanation_vi": "월 = tháng, 일 = ngày. Đọc theo số Hán-Hàn: 일(1), 이(2), 삼(3), 사(4), 오(5), 육(6), 칠(7), 팔(8), 구(9), 십(10), 십일(11), 십이(12). Ví dụ: 3월 15일 = ngày 15 tháng 3.",
      "examples": [
        { "kr": "오늘은 3월 15일이에요.", "vi": "Hôm nay là ngày 15 tháng 3." },
        { "kr": "제 생일은 7월 10일이에요.", "vi": "Sinh nhật tôi là ngày 10 tháng 7." }
      ]
    },
    {
      "pattern": "-아야/어야 해요",
      "meaning": "Phải làm gì",
      "explanation_vi": "Diễn tả nghĩa vụ hoặc điều cần thiết. Giống 'phải' trong tiếng Việt. Bỏ 다 của động từ + 아야/어야 해요. Động từ có ㅏ/ㅗ ở âm cuối dùng 아야, còn lại dùng 어야.",
      "examples": [
        { "kr": "9시까지 가야 해요.", "vi": "Phải đến trước 9 giờ." },
        { "kr": "신분증을 가져와야 해요.", "vi": "Phải mang theo chứng minh thư." },
        { "kr": "안전모를 써야 해요.", "vi": "Phải đội mũ bảo hiểm." }
      ]
    },
    {
      "pattern": "N까지",
      "meaning": "Đến N / Trước N (giới hạn thời gian/địa điểm)",
      "explanation_vi": "까지 = đến/cho đến. Dùng cho thời gian (까지 = trước..., không được trễ) hoặc địa điểm (đến nơi). Rất quan trọng trong môi trường làm việc.",
      "examples": [
        { "kr": "8시까지 출근해야 해요.", "vi": "Phải đến làm trước 8 giờ." },
        { "kr": "이번 주 금요일까지 제출해야 해요.", "vi": "Phải nộp trước thứ Sáu tuần này." }
      ]
    }
  ],
